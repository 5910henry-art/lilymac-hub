// ============================================================
// Accumulator
// ============================================================

export async function getAccumulator(params = {}) {
  const qs = new URLSearchParams(params).toString();

  const r = await request(
    `/accumulator${qs ? `?${qs}` : ""}`
  );

  if (!r?.success) {
    return {
      success: false,
      data: {},
    };
  }

  await ensureTeams();

  const d = r.data || {};

  // Normalize each date/market key into an array.
  for (const key in d) {
    if (!Array.isArray(d[key])) {
      const value = d[key];
      const arr = [];

      if (
        value &&
        typeof value === "object"
      ) {
        Object.values(value).forEach((v) => {
          if (Array.isArray(v)) {
            arr.push(...v);
          }
        });
      }

      d[key] = arr;
    }
  }

  return {
    ...r,
    data: d,
  };
}
