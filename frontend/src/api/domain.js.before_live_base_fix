// ============================================================
// Predictions
// ============================================================

export async function getPredictionsLatest(params = {}) {
  const qs = new URLSearchParams(params).toString();

  const r = await request(
    `/predictions/latest${qs ? `?${qs}` : ""}`
  );

  if (!r) {
    return {
      success: false,
      data: {
        predictions: [],
      },
    };
  }

  await ensureTeams();

  const rawPredictions =
    r?.data?.predictions ||
    r?.predictions ||
    (Array.isArray(r) ? r : []) ||
    [];

  const normalized = Array.isArray(rawPredictions)
    ? rawPredictions.map((p) =>
        attachLogosSafe(
          {
            ...p,

            // Normalize date spelling.
            utcDate:
              p?.utcDate ||
              p?.utcdate ||
              null,

            localDate:
              p?.localDate ||
              null,
          },
          "home_team_name",
          "away_team_name"
        )
      )
    : [];

  return {
    success: true,
    data: {
      predictions: normalized,
    },
  };
}

// ============================================================
// Grouped Predictions
// ============================================================

export async function getGroupedPredictions({
  home,
  away,
  match_id,
} = {}) {
  const params = new URLSearchParams();

  if (home) {
    params.append("home", home);
  }

  if (away) {
    params.append("away", away);
  }

  if (match_id) {
    params.append("match_id", match_id);
  }

  const qs = params.toString();

  const r = await request(
    `/predictions/match/grouped${qs ? `?${qs}` : ""}`
  );

  if (!r) {
    return {
      success: false,
      data: [],
    };
  }

  /*
   * IMPORTANT:
   *
   * Backend /predictions/match/grouped currently returns:
   *
   * [
   *   {
   *     match_id,
   *     home,
   *     away,
   *     utcDate,
   *     grouped_predictions
   *   }
   * ]
   *
   * It does NOT return:
   *
   * {
   *   success: true,
   *   data: [...]
   * }
   *
   * Therefore do NOT check r.success here.
   */

  const rawMatches =
    Array.isArray(r)
      ? r
      : Array.isArray(r?.data)
      ? r.data
      : Array.isArray(r?.data?.matches)
      ? r.data.matches
      : Array.isArray(r?.matches)
      ? r.matches
      : [];

  await ensureTeams();

  const normalized = rawMatches.map((match) => {
    const normalizedMatch = {
      ...match,

      // Normalize backend date spelling.
      utcDate:
        match?.utcDate ||
        match?.utcdate ||
        null,

      // If backend/global date normalization provides localDate,
      // preserve it.
      localDate:
        match?.localDate ||
        null,

      // Grouped endpoint uses "home" and "away", not
      // home_team_name / away_team_name.
      home_team_name:
        match?.home_team_name ||
        match?.home ||
        "",

      away_team_name:
        match?.away_team_name ||
        match?.away ||
        "",
    };

    return attachLogosSafe(
      normalizedMatch,
      "home_team_name",
      "away_team_name"
    );
  });

  return {
    success: true,
    data: normalized,
    matches: normalized,
  };
}

