export async function getLiveMatches(params = {}) {
  const qs = new URLSearchParams(params).toString();

  /*
   * IMPORTANT:
   *
   * Live matches come from the dedicated backend
   * /live endpoint.
   *
   * The backend strictly returns only:
   *
   *     IN_PLAY
   *     PAUSED
   *
   * No frontend status mapping is performed.
   */

  const r = await request(
    `/live${qs ? `?${qs}` : ""}`
  );

  if (!r?.success) return r;

  await ensureTeams();

  if (Array.isArray(r.data?.matches)) {
    r.data.matches = r.data.matches.map((m) =>
      attachLogosSafe(
        {
          ...m,

          /*
           * /live already uses home_team / away_team.
           * Map them into the keys expected by the
           * existing logo helper.
           */

          home_team_name:
            m?.home_team_name ||
            m?.home_team ||
            "",

          away_team_name:
            m?.away_team_name ||
            m?.away_team ||
            "",
        },

        "home_team_name",
        "away_team_name"
      )
    );
  }

  return r;
}

