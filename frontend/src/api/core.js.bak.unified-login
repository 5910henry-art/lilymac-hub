/* src/api/core.js */

export const DEFAULT_TIMEOUT = 15000;

// ============================================================
// BACKEND URLS
// ============================================================

export const BACKEND_BASE =
  process.env.REACT_APP_BACKEND_URL ||
  "https://lilymac-hub.onrender.com";

export const BACKEND_FOOTBALL =
  process.env.REACT_APP_FOOTBALL_API_URL ||
  `${BACKEND_BASE}/app`;

export const BACKEND_ADMIN =
  process.env.REACT_APP_ADMIN_API_URL ||
  `${BACKEND_BASE}/vipadmin`;

export const BACKEND_BET =
  process.env.REACT_APP_BET_API_URL ||
  `${BACKEND_BASE}/bet`;

export const BACKEND_VIRTUAL =
  process.env.REACT_APP_VIRTUAL_API_URL ||
  "https://lilymac-hub-1.onrender.com";

// ============================================================
// AUTH TOKEN
// ============================================================

let authToken = null;

if (typeof localStorage !== "undefined") {
  const stored =
    localStorage.getItem("token") ||
    localStorage.getItem("auth_token") ||
    localStorage.getItem("vip_token");

  if (stored) {
    authToken = stored;
  }
}

export function getAuthToken() {
  if (authToken) {
    return authToken;
  }

  if (typeof localStorage === "undefined") {
    return null;
  }

  return (
    localStorage.getItem("token") ||
    localStorage.getItem("auth_token") ||
    localStorage.getItem("vip_token") ||
    null
  );
}

export function setToken(token) {
  authToken = token || null;

  if (typeof localStorage !== "undefined") {
    if (token) {
      localStorage.setItem("token", token);
    } else {
      localStorage.removeItem("token");
      localStorage.removeItem("auth_token");
      localStorage.removeItem("vip_token");
    }
  }
}

export function clearToken() {
  authToken = null;

  if (typeof localStorage !== "undefined") {
    localStorage.removeItem("token");
    localStorage.removeItem("auth_token");
    localStorage.removeItem("vip_token");
  }
}

// ============================================================
// ERROR HANDLING
// ============================================================

function isHtmlResponse(value) {
  if (typeof value !== "string") {
    return false;
  }

  const text = value.trim().toLowerCase();

  return (
    text.startsWith("<!doctype") ||
    text.startsWith("<html") ||
    text.includes("<html") ||
    text.includes("<head>") ||
    text.includes("<body") ||
    text.includes("<title>500 internal server error") ||
    text.includes("internal server error</h1>") ||
    text.includes("werkzeug")
  );
}

function cleanErrorMessage(value) {
  if (value === null || value === undefined) {
    return "";
  }

  if (typeof value !== "string") {
    return "";
  }

  const message = value.trim();

  if (!message) {
    return "";
  }

  // NEVER expose HTML pages to users.
  if (isHtmlResponse(message)) {
    return "";
  }

  return message;
}

function extractBackendMessage(data) {
  if (!data) {
    return "";
  }

  if (typeof data === "string") {
    return cleanErrorMessage(data);
  }

  if (typeof data !== "object") {
    return "";
  }

  const candidates = [
    data.message,
    data.error,
    data.msg,
    data.detail,
  ];

  for (const candidate of candidates) {
    const cleaned = cleanErrorMessage(candidate);

    if (cleaned) {
      return cleaned;
    }
  }

  return "";
}

function getFriendlyErrorMessage(status, data, path = "") {
  const normalizedPath = String(path || "").toLowerCase();

  const backendMessage = extractBackendMessage(data);

  // ----------------------------------------------------------
  // AUTH
  // ----------------------------------------------------------

  if (normalizedPath.startsWith("/login")) {
    if (status === 400) {
      return (
        backendMessage ||
        "Please check your phone number and password."
      );
    }

    if (status === 401) {
      return "Incorrect phone number or password.";
    }

    if (status === 403) {
      return (
        backendMessage ||
        "Your account is not allowed to sign in."
      );
    }

    if (status === 404) {
      return "We couldn't find an account with those details.";
    }
  }

  if (normalizedPath.startsWith("/signup")) {
    if (status === 400 || status === 422) {
      return (
        backendMessage ||
        "Please check the information you entered."
      );
    }

    if (status === 409) {
      return (
        backendMessage ||
        "An account with this phone number already exists."
      );
    }

    if (status === 403) {
      return (
        backendMessage ||
        "You are not allowed to create an account."
      );
    }
  }

  // ----------------------------------------------------------
  // COMMON HTTP ERRORS
  // ----------------------------------------------------------

  switch (status) {
    case 400:
      return (
        backendMessage ||
        "The request could not be completed. Please check your information."
      );

    case 401:
      return (
        backendMessage ||
        "Your session has expired. Please sign in again."
      );

    case 403:
      return (
        backendMessage ||
        "You are not allowed to perform this action."
      );

    case 404:
      return (
        backendMessage ||
        "The requested service could not be found."
      );

    case 409:
      return (
        backendMessage ||
        "This request conflicts with existing information."
      );

    case 422:
      return (
        backendMessage ||
        "Some of the information provided is invalid."
      );

    case 429:
      return (
        backendMessage ||
        "Too many requests. Please wait a moment and try again."
      );

    // --------------------------------------------------------
    // SERVER ERRORS
    // --------------------------------------------------------

    case 500:
    case 501:
    case 502:
    case 503:
    case 504:
      return "Something went wrong on our server. Please try again shortly.";

    default:
      break;
  }

  // ----------------------------------------------------------
  // SAFE BACKEND MESSAGE
  // ----------------------------------------------------------

  if (backendMessage) {
    const lower = backendMessage.toLowerCase();

    const technical =
      lower.includes("traceback") ||
      lower.includes("werkzeug") ||
      lower.includes("sqlalchemy") ||
      lower.includes("psycopg") ||
      lower.includes("exception") ||
      lower.includes("internal server error") ||
      lower.includes("<html") ||
      lower.includes("<!doctype");

    if (!technical) {
      return backendMessage;
    }
  }

  return "The request could not be completed. Please try again.";
}

// ============================================================
// TOKEN REFRESH
// ============================================================

let refreshing = false;

async function refreshToken() {
  if (refreshing) {
    return null;
  }

  refreshing = true;

  try {
    const token = getAuthToken();

    if (!token) {
      return null;
    }

    const res = await fetch(
      `${BACKEND_BET}/refresh`,
      {
        method: "POST",
        headers: {
          Authorization: `Bearer ${token}`,
        },
      }
    );

    if (!res.ok) {
      throw new Error("refresh failed");
    }

    const data = await res.json();

    const newToken =
      data?.token ||
      data?.data?.token ||
      data?.data?.data?.token ||
      null;

    if (newToken) {
      setToken(newToken);
      return newToken;
    }
  } catch (error) {
    console.error(
      "Token refresh failed:",
      error
    );

    clearToken();
  } finally {
    refreshing = false;
  }

  return null;
}

// ============================================================
// FETCH WITH TIMEOUT
// ============================================================

async function timeoutFetch(ms, fetchFn) {
  const controller = new AbortController();

  const id = setTimeout(() => {
    controller.abort();
  }, ms);

  try {
    return await fetchFn(controller.signal);
  } finally {
    clearTimeout(id);
  }
}

// ============================================================
// RAW FETCH
// ============================================================

export async function rawFetch(
  method,
  fullUrl,
  {
    headers = {},
    body = null,
    timeout = DEFAULT_TIMEOUT,
  } = {}
) {
  const options = {
    method,
    headers,
  };

  if (body != null) {
    if (
      typeof body === "object" &&
      !(body instanceof FormData)
    ) {
      options.body = JSON.stringify(body);

      options.headers = {
        ...headers,
        "Content-Type": "application/json",
        Accept: "application/json",
      };
    } else {
      options.body = body;
    }
  }

  // ----------------------------------------------------------
  // DEBUG BET STAKE
  // ----------------------------------------------------------

  if (
    fullUrl.includes("/place_bet") &&
    body
  ) {
    try {
      const payload =
        typeof body === "string"
          ? JSON.parse(body)
          : body;

      if (
        !payload.stake ||
        Number(payload.stake) < 1
      ) {
        console.warn(
          "⚠️ Attempting to place bet with invalid stake:",
          payload
        );
      }
    } catch {
      // Ignore debug parsing failures.
    }
  }

  return timeoutFetch(
    timeout,
    (signal) =>
      fetch(fullUrl, {
        ...options,
        signal,
      })
  );
}

// ============================================================
// REQUESTER
// ============================================================

export function makeRequester(baseUrl) {
  const base = String(baseUrl)
    .replace(/\/+$/, "");

  async function requestRawFor(
    path,
    opts = {},
    retry = true
  ) {
    const url =
      path.startsWith("/")
        ? `${base}${path}`
        : `${base}/${path}`;

    const headers = {
      Accept: "application/json",
      ...(opts.headers || {}),
    };

    const token = getAuthToken();

    if (
      token &&
      !headers.Authorization
    ) {
      headers.Authorization =
        `Bearer ${token}`;
    }

    try {
      const res =
        await rawFetch(
          opts.method || "GET",
          url,
          {
            ...opts,
            headers,
          }
        );

      const text =
        await res.text();

      let data = null;

      /*
       * Safely parse JSON.
       *
       * If Flask returns HTML, data remains the
       * HTML string, but it will NEVER be exposed
       * directly to the user.
       */
      try {
        data = text
          ? JSON.parse(text)
          : null;
      } catch {
        data = text || null;
      }

      // --------------------------------------------------------
      // TOKEN EXPIRED
      // --------------------------------------------------------

      const isAuthRoute =
        path === "/login" ||
        path === "/signup" ||
        path === "/refresh";

      if (
        res.status === 401 &&
        retry &&
        !isAuthRoute
      ) {
        const newToken =
          await refreshToken();

        if (newToken) {
          headers.Authorization =
            `Bearer ${newToken}`;

          return requestRawFor(
            path,
            {
              ...opts,
              headers,
            },
            false
          );
        }

        clearToken();
      }

      // --------------------------------------------------------
      // ERROR
      // --------------------------------------------------------

      if (!res.ok) {
        const errorMessage =
          getFriendlyErrorMessage(
            res.status,
            data,
            path
          );

        /*
         * IMPORTANT:
         *
         * Do NOT return raw HTML.
         * Do NOT JSON.stringify an HTML response.
         * Do NOT expose Render/Flask internals.
         */

        return {
          success: false,
          status: res.status,
          error: errorMessage,
          message: errorMessage,

          /*
           * Keep the original data available for
           * internal consumers if needed.
           *
           * The UI should use error/message, never
           * render this raw value.
           */
          data,
        };
      }

      // --------------------------------------------------------
      // SUCCESS
      // --------------------------------------------------------

      return {
        success: true,
        status: res.status,
        data,
      };
    } catch (err) {
      // --------------------------------------------------------
      // NETWORK / TIMEOUT
      // --------------------------------------------------------

      if (err?.name === "AbortError") {
        return {
          success: false,
          status: 0,
          error:
            "The request took too long. Please try again.",
          message:
            "The request took too long. Please try again.",
          data: null,
        };
      }

      /*
       * fetch() throws TypeError on many network failures.
       */
      const networkError =
        err?.name === "TypeError" ||
        String(err?.message || "")
          .toLowerCase()
          .includes("failed to fetch") ||
        String(err?.message || "")
          .toLowerCase()
          .includes("network");

      if (networkError) {
        return {
          success: false,
          status: 0,
          error:
            "Unable to connect to Lilymac Hub. Please check your internet connection.",
          message:
            "Unable to connect to Lilymac Hub. Please check your internet connection.",
          data: null,
        };
      }

      console.error(
        "Request failed:",
        err
      );

      return {
        success: false,
        status: 0,
        error:
          "Something went wrong while processing your request. Please try again.",
        message:
          "Something went wrong while processing your request. Please try again.",
        data: null,
      };
    }
  }

  async function request(
    path,
    method = "GET",
    body = null,
    token = null
  ) {
    const headers = token
      ? {
          Authorization:
            `Bearer ${token}`,
        }
      : {};

    return requestRawFor(
      path,
      {
        method,
        body,
        headers,
      }
    );
  }

  return {
    requestRaw: requestRawFor,
    request,
  };
}

// ============================================================
// ROUTE -> BACKEND
// ============================================================

function resolveBackend(path) {
  const normalizedPath =
    String(path || "").split("?")[0];

  // ----------------------------------------------------------
  // ADMIN / VIP API
  // ----------------------------------------------------------

  if (
    normalizedPath.startsWith("/vip") ||
    normalizedPath.startsWith("/admin")
  ) {
    return BACKEND_ADMIN;
  }

  // ----------------------------------------------------------
  // BETTING API
  // ----------------------------------------------------------

  const betPaths = [
    // AUTH
    "/login",
    "/signup",
    "/refresh",

    // USER / PROFILE
    "/me",
    "/change_password",
    "/reset_password",
    "/delete_account",

    // WALLET
    "/balance",
    "/deposit",
    "/withdraw",
    "/transactions",
    "/balance_history",

    // M-PESA
    "/mpesa/stkpush",

    // BETTING
    "/place_bet",
    "/my_bets",

    // TICKETS
    "/tickets",
    "/ticket",

    // CASHOUT
    "/cashout",

    // MARKETS / ODDS
    "/odds",
    "/markets",

    // STATS / PROFIT
    "/stats",
    "/profit",
    "/profit_history",
  ];

  if (
    betPaths.some((p) =>
      normalizedPath.startsWith(p)
    )
  ) {
    return BACKEND_BET;
  }

  // ----------------------------------------------------------
  // FOOTBALL / APP API
  // ----------------------------------------------------------

  return BACKEND_FOOTBALL;
}

// ============================================================
// PUBLIC REQUEST FUNCTIONS
// ============================================================

export async function requestRaw(
  path,
  opts = {}
) {
  const backend =
    resolveBackend(path);

  const requester =
    makeRequester(backend);

  return requester.requestRaw(
    path,
    opts
  );
}

export async function request(
  path,
  method = "GET",
  body = null,
  token = null
) {
  const backend =
    resolveBackend(path);

  const requester =
    makeRequester(backend);

  return requester.request(
    path,
    method,
    body,
    token
  );
}
