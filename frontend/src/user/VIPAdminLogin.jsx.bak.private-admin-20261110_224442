import React, { useState } from "react";
import { useNavigate, useSearchParams } from "react-router-dom";
import { vipLogin, adminLogin } from "../api/authVipAdmin";

function normalizeToE164(input) {
  if (!input) return "";

  const value = String(input).replace(/\s|-/g, "");

  if (/^0\d{9}$/.test(value)) return "254" + value.slice(1);
  if (/^[71]\d{8}$/.test(value)) return "254" + value;
  if (/^254\d+$/.test(value)) return value;

  return value;
}

function responseData(res) {
  return res?.data?.data || res?.data || res || {};
}

function responseToken(res) {
  return (
    res?.data?.token ||
    res?.token ||
    res?.data?.data?.token ||
    null
  );
}

export default function VIPAdminLogin() {
  const navigate = useNavigate();
  const [searchParams] = useSearchParams();

  const [mode, setMode] = useState(
    searchParams.get("mode") === "admin" ? "admin" : "vip"
  );
  const [identifier, setIdentifier] = useState("");
  const [password, setPassword] = useState("");
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState("");

  const isAdmin = mode === "admin";

  const submit = async (event) => {
    event.preventDefault();
    setError("");

    if (!identifier.trim() || !password) {
      setError("Enter your login details.");
      return;
    }

    setLoading(true);

    try {
      const res = isAdmin
        ? await adminLogin(identifier.trim(), password)
        : await vipLogin(normalizeToE164(identifier), password);

      const data = responseData(res);
      const token = responseToken(res);

      if (!token) {
        throw new Error(
          data?.error ||
          data?.message ||
          res?.error ||
          "Login failed. Check your details and try again."
        );
      }

      if (isAdmin) {
        const adminUser =
          data?.admin ||
          data?.data?.admin ||
          { username: identifier.trim() };

        localStorage.setItem("admin_token", token);
        localStorage.setItem("admin_user", JSON.stringify(adminUser));
        navigate("/admin", { replace: true });
      } else {
        localStorage.setItem("vip_token", token);
        navigate("/vip", { replace: true });
      }
    } catch (err) {
      setError(
        err?.message || "Unable to sign in. Please try again."
      );
    } finally {
      setLoading(false);
    }
  };

  const styles = {
    page: {
      minHeight: "100vh",
      display: "flex",
      alignItems: "center",
      justifyContent: "center",
      padding: "24px 16px",
      boxSizing: "border-box",
      background: "linear-gradient(145deg, #07111f, #101d32)",
      color: "#f8fafc",
      fontFamily: "Arial, sans-serif",
    },
    card: {
      width: "100%",
      maxWidth: 420,
      padding: "30px 24px",
      boxSizing: "border-box",
      border: "1px solid #26364d",
      borderRadius: 18,
      background: "#111d2e",
      boxShadow: "0 20px 60px rgba(0,0,0,.35)",
    },
    button: {
      width: "100%",
      padding: "13px 10px",
      border: 0,
      borderRadius: 10,
      background: "#eab308",
      color: "#111827",
      fontWeight: 700,
      fontSize: 15,
      cursor: "pointer",
    },
    input: {
      width: "100%",
      boxSizing: "border-box",
      padding: "13px 12px",
      marginTop: 7,
      border: "1px solid #35465e",
      borderRadius: 9,
      background: "#0b1524",
      color: "#fff",
      fontSize: 15,
      outline: "none",
    },
    label: {
      display: "block",
      marginTop: 18,
      color: "#cbd5e1",
      fontSize: 13,
      fontWeight: 600,
    },
  };

  return (
    <main style={styles.page}>
      <section style={styles.card}>
        <div style={{ textAlign: "center", marginBottom: 25 }}>
          <div style={{ fontSize: 30, marginBottom: 8 }}>⚽</div>
          <h1 style={{ margin: 0, fontSize: 25 }}>LilyMac Hub</h1>
          <p style={{ color: "#94a3b8", marginBottom: 0 }}>
            VIP and administrator access
          </p>
        </div>

        <div style={{
          display: "grid",
          gridTemplateColumns: "1fr 1fr",
          gap: 8,
          padding: 5,
          borderRadius: 11,
          background: "#0b1524",
        }}>
          {["vip", "admin"].map((item) => (
            <button
              key={item}
              type="button"
              onClick={() => {
                setMode(item);
                setIdentifier("");
                setPassword("");
                setError("");
              }}
              style={{
                padding: "11px 8px",
                border: 0,
                borderRadius: 8,
                background: mode === item ? "#eab308" : "transparent",
                color: mode === item ? "#111827" : "#cbd5e1",
                fontWeight: 700,
                cursor: "pointer",
              }}
            >
              {item === "vip" ? "VIP Login" : "Admin Login"}
            </button>
          ))}
        </div>

        <h2 style={{ fontSize: 19, margin: "24px 0 5px" }}>
          {isAdmin ? "Administrator sign in" : "VIP member sign in"}
        </h2>
        <p style={{ color: "#94a3b8", fontSize: 13, marginTop: 0 }}>
          {isAdmin
            ? "Use your administrator username and password."
            : "Use your registered phone number and password."}
        </p>

        <form onSubmit={submit}>
          <label style={styles.label}>
            {isAdmin ? "Username" : "Phone number"}
            <input
              style={styles.input}
              type={isAdmin ? "text" : "tel"}
              value={identifier}
              onChange={(e) => setIdentifier(e.target.value)}
              placeholder={isAdmin ? "Admin username" : "07XXXXXXXX"}
              autoComplete={isAdmin ? "username" : "tel"}
              required
            />
          </label>

          <label style={styles.label}>
            Password
            <input
              style={styles.input}
              type="password"
              value={password}
              onChange={(e) => setPassword(e.target.value)}
              placeholder="Enter your password"
              autoComplete="current-password"
              required
            />
          </label>

          {error && (
            <p role="alert" style={{
              color: "#fca5a5",
              background: "rgba(127,29,29,.2)",
              border: "1px solid #7f1d1d",
              borderRadius: 8,
              padding: 10,
              fontSize: 13,
              lineHeight: 1.5,
            }}>
              {error}
            </p>
          )}

          <button
            type="submit"
            disabled={loading}
            style={{
              ...styles.button,
              marginTop: 24,
              opacity: loading ? 0.65 : 1,
            }}
          >
            {loading ? "Signing in..." : "Sign in"}
          </button>
        </form>

        {!isAdmin && (
          <p style={{
            color: "#94a3b8",
            textAlign: "center",
            fontSize: 13,
            marginTop: 22,
          }}>
            New to VIP?{" "}
            <button
              type="button"
              onClick={() => navigate("/vip")}
              style={{
                border: 0,
                padding: 0,
                background: "none",
                color: "#facc15",
                fontWeight: 700,
                cursor: "pointer",
              }}
            >
              Register here
            </button>
          </p>
        )}

        <button
          type="button"
          onClick={() => navigate("/auth")}
          style={{
            display: "block",
            margin: "18px auto 0",
            border: 0,
            background: "none",
            color: "#94a3b8",
            cursor: "pointer",
            fontSize: 12,
          }}
        >
          Back to regular user login
        </button>
      </section>
    </main>
  );
}
