// src/api/domain.js
// Football API domain layer
// Handles backend requests, team/logo lookup, date normalization,
// predictions, grouped predictions, tips, matches, teams and players.

import { makeRequester, BACKEND_FOOTBALL } from "./core.js";

const { requestRaw, request } = makeRequester(BACKEND_FOOTBALL);

// Toggle debug logs temporarily when debugging.
const DEBUG = false;

// ============================================================
// Teams / Logos helpers
// ============================================================

let teamMap = null; // numeric-id -> team object
let nameMap = null; // normalized name -> team object

function normalize(str = "") {
  return String(str || "")
    .toLowerCase()
    .trim()
    .replace(/\s+/g, "")
    .replace(/[^\w]/g, "");
}

// ============================================================
// SVG / Logo helpers
// ============================================================

function svgToDataUri(svg) {
  try {
    if (typeof btoa !== "undefined") {
      return `data:image/svg+xml;base64,${btoa(svg)}`;
    }
  } catch (e) {
    // Fall through to URI encoding.
  }

  return `data:image/svg+xml;utf8,${encodeURIComponent(svg)}`;
}

function normalizeLogoUrl(url) {
  if (!url) return null;

  if (typeof url === "string") {
    const t = url.trim();

    if (
      t.startsWith("data:") ||
      t.startsWith("blob:") ||
      t.startsWith("<svg")
    ) {
      return url;
    }
  }

  try {
    if (typeof url !== "string") return url;

    // Relative URL.
    if (url.startsWith("/")) {
      return url;
    }

    const parsed = new URL(url, window.location.origin);

    // Rewrite localhost / 127.0.0.1 to the current frontend/tunnel origin.
    if (
      parsed.hostname === "localhost" ||
      parsed.hostname === "127.0.0.1"
    ) {
      return (
        window.location.origin +
        parsed.pathname +
        parsed.search +
        parsed.hash
      );
    }

    // Avoid mixed-content blocking when frontend is HTTPS.
    if (
      window.location.protocol === "https:" &&
      parsed.protocol === "http:"
    ) {
      parsed.protocol = "https:";
    }

    return parsed.toString();
  } catch (e) {
    return url;
  }
}

function generateFootballBadge(teamName = "FC") {
  const initials = String(teamName || "FC")
    .split(/\s+/)
    .map((w) => (w ? w[0] : ""))
    .slice(0, 2)
    .join("")
    .toUpperCase() || "FC";

  const hash = [...String(teamName)].reduce(
    (a, c) => a + c.charCodeAt(0),
    0
  );

  const color = `hsl(${hash % 360},70%,45%)`;

  const svg = `
  <svg xmlns="http://www.w3.org/2000/svg" width="120" height="120" viewBox="0 0 120 120">
    <defs>
      <linearGradient id="g" x1="0" x2="1" y1="0" y2="1">
        <stop offset="0" stop-color="${color}" stop-opacity="0.95"/>
        <stop offset="1" stop-color="${color}" stop-opacity="0.8"/>
      </linearGradient>
    </defs>
    <rect width="120" height="120" rx="18" ry="18" fill="url(#g)" />
    <rect
      x="6"
      y="6"
      width="108"
      height="108"
      rx="14"
      ry="14"
      fill="none"
      stroke="white"
      stroke-width="4"
      opacity="0.18"
    />
    <text
      x="50%"
      y="54%"
      font-size="44"
      fill="white"
      font-family="system-ui, Arial, sans-serif"
      text-anchor="middle"
      dominant-baseline="middle"
      font-weight="700"
    >
      ${initials}
    </text>
  </svg>
  `;

  return svgToDataUri(svg);
}

function extractLogoFromTeam(team) {
  if (!team) return null;

  const raw =
    team.svg ||
    team.crest ||
    team.logo ||
    team.badge ||
    team.image ||
    null;

  if (!raw) return null;

  if (
    typeof raw === "string" &&
    raw.trim().startsWith("<svg")
  ) {
    return svgToDataUri(raw);
  }

  if (
    typeof raw === "string" &&
    raw.trim().startsWith("data:")
  ) {
    return raw;
  }

  return normalizeLogoUrl(raw);
}

// ============================================================
// Load teams
// ============================================================

export async function loadTeams() {
  if (teamMap && Object.keys(teamMap).length) {
    return teamMap;
  }

  try {
    const r = await requestRaw("/teams");

    if (!r) {
      if (DEBUG) {
        console.warn("loadTeams: empty response");
      }

      teamMap = {};
      nameMap = {};
      return teamMap;
    }

    // Backend normally returns:
    // { count, teams }
    //
    // But support wrapped and raw responses too.
    const teams =
      r?.data?.teams ||
      r?.teams ||
      (Array.isArray(r) ? r : []);

    if (!Array.isArray(teams)) {
      if (DEBUG) {
        console.warn("loadTeams: invalid teams response", r);
      }

      teamMap = {};
      nameMap = {};
      return teamMap;
    }

    teamMap = {};
    nameMap = {};

    teams.forEach((team) => {
      if (!team) return;

      const idNum = Number(team.id);

      if (!Number.isNaN(idNum)) {
        teamMap[idNum] = team;
      }

      const candidates = [
        team.name,
        team.short_name,
        team.shortName,
        team.tla,
        team.team_name,
        team.club_name,
      ].filter(Boolean);

      candidates.forEach((candidate) => {
        const key = normalize(candidate);

        if (key && !nameMap[key]) {
          nameMap[key] = team;
        }
      });

      const fullName = normalize(team.name || "");

      if (fullName && !nameMap[fullName]) {
        nameMap[fullName] = team;
      }
    });

    if (DEBUG) {
      console.log(
        "loadTeams: loaded teams count =",
        Object.keys(teamMap).length
      );

      console.log(
        "loadTeams: sample keys =",
        Object.keys(teamMap).slice(0, 10)
      );
    }

    return teamMap;
  } catch (err) {
    console.error("Error loading teams:", err);

    teamMap = {};
    nameMap = {};

    return teamMap;
  }
}

export async function ensureTeams() {
  if (!teamMap || !Object.keys(teamMap).length) {
    await loadTeams();
  }
}

// ============================================================
// Logo lookup
// ============================================================

function getLogo(id, name) {
  const numericId = Number(id);

  if (
    !Number.isNaN(numericId) &&
    teamMap &&
    teamMap[numericId]
  ) {
    const logo = extractLogoFromTeam(teamMap[numericId]);

    if (logo) return logo;
  }

  if (name && nameMap) {
    const key = normalize(name);
    const team = nameMap[key];

    if (team) {
      const logo = extractLogoFromTeam(team);

      if (logo) return logo;
    }

    const fallback = Object.values(teamMap || {}).find((team) => {
      if (!team) return false;

      return (
        normalize(team.name) === key ||
        normalize(team.short_name || team.shortName || "") === key ||
        normalize(team.tla || "") === key
      );
    });

    if (fallback) {
      const logo = extractLogoFromTeam(fallback);

      if (logo) return logo;
    }
  }

  return generateFootballBadge(name || "FC");
}

// ============================================================
// Attach logos
// ============================================================

export function attachLogosSafe(
  item,
  homeNameKey = "home_team_name",
  awayNameKey = "away_team_name",
  homeIdKey = "home_team_id",
  awayIdKey = "away_team_id"
) {
  if (!item) return item;

  if (!teamMap || !Object.keys(teamMap).length) {
    return {
      ...item,
      home_logo: generateFootballBadge(
        item?.[homeNameKey] || "FC"
      ),
      away_logo: generateFootballBadge(
        item?.[awayNameKey] || "FC"
      ),
    };
  }

  const homeLogo = getLogo(
    item?.[homeIdKey],
    item?.[homeNameKey]
  );

  const awayLogo = getLogo(
    item?.[awayIdKey],
    item?.[awayNameKey]
  );

  return {
    ...item,
    home_logo: homeLogo,
    away_logo: awayLogo,
  };
}

