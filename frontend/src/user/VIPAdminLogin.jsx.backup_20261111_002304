import React, { useRef, useState } from "react";
import { useNavigate } from "react-router-dom";
import { vipLogin, adminLogin } from "../api/authVipAdmin";

function normalizeToE164(input) {
  if (!input) return "";

  const value = String(input).replace(/\s|-/g, "");

  if (/^0\d{9}$/.test(value)) return "254" + value.slice(1);
  if (/^[71]\d{8}$/.test(value)) return "254" + value;
  if (/^254\d+$/.test(value)) return value;

  return value;
}

function responseData(res) {
  return res?.data?.data || res?.data || res || {};
}

function responseToken(res) {
  return (
    res?.data?.token ||
    res?.token ||
    res?.data?.data?.token ||
    null
  );
}

export default function VIPAdminLogin({ adminOnly = false }) {
  const navigate = useNavigate();

  const [identifier, setIdentifier] = useState("");
  const [password, setPassword] = useState("");
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState("");
  const [mode, setMode] = useState(adminOnly ? "admin" : "vip");

  const tapCount = useRef(0);
  const lastTap = useRef(0);

  const isAdmin = mode === "admin";

  const handleTitleTap = () => {
    if (adminOnly) return;

    const now = Date.now();

    if (now - lastTap.current > 800) {
      tapCount.current = 0;
    }

    lastTap.current = now;
    tapCount.current += 1;

    if (tapCount.current >= 3) {
      tapCount.current = 0;
      setMode(current => current === "vip" ? "admin" : "vip");
      setIdentifier("");
      setPassword("");
      setError("");
    }
  };

  const submit = async (event) => {
    event.preventDefault();
    setError("");

    if (!identifier.trim() || !password) {
      setError("Enter your login details.");
      return;
    }

    setLoading(true);

    try {
      const res = isAdmin
        ? await adminLogin(identifier.trim(), password)
        : await vipLogin(normalizeToE164(identifier), password);

      const data = responseData(res);
      const token = responseToken(res);

      if (!token) {
        throw new Error(
          data?.error ||
          data?.message ||
          res?.error ||
          "Login failed. Check your details and try again."
        );
      }

      if (isAdmin) {
        const adminUser =
          data?.admin ||
          data?.data?.admin ||
          { username: identifier.trim() };

        localStorage.setItem("admin_token", token);
        localStorage.setItem("admin_user", JSON.stringify(adminUser));
        navigate("/admin", { replace: true });
      } else {
        localStorage.setItem("vip_token", token);
        navigate("/vip", { replace: true });
      }
    } catch (err) {
      setError(
        err?.message || "Unable to sign in. Please try again."
      );
    } finally {
      setLoading(false);
    }
  };

  const styles = {
    page: {
      minHeight: "100vh",
      display: "flex",
      alignItems: "center",
      justifyContent: "center",
      padding: "24px 16px",
      boxSizing: "border-box",
      background: "linear-gradient(145deg, #f8fafc, #eaf0f8)",
      color: "#0f172a",
      fontFamily: "Arial, sans-serif",
    },
    card: {
      width: "100%",
      maxWidth: 420,
      padding: "30px 24px",
      boxSizing: "border-box",
      border: "1px solid #dbe4f0",
      borderRadius: 18,
      background: "#ffffff",
      boxShadow: "0 20px 60px rgba(15,23,42,.12)",
    },
    button: {
      width: "100%",
      padding: "13px 10px",
      border: 0,
      borderRadius: 10,
      background: "linear-gradient(135deg, #2563EB, #DC2626)",
      color: "#ffffff",
      fontWeight: 700,
      fontSize: 15,
      cursor: "pointer",
    },
    input: {
      width: "100%",
      boxSizing: "border-box",
      padding: "13px 12px",
      marginTop: 7,
      border: "1px solid #cbd5e1",
      borderRadius: 9,
      background: "#ffffff",
      color: "#0f172a",
      fontSize: 15,
      outline: "none",
    },
    label: {
      display: "block",
      marginTop: 18,
      color: "#334155",
      fontSize: 13,
      fontWeight: 600,
    },
  };

  return (
    <main style={styles.page}>
      <section style={styles.card}>
        <div style={{ textAlign: "center", marginBottom: 25 }}>
          <div style={{ fontSize: 30, marginBottom: 8 }}>⚽</div>
          <h1
            onClick={handleTitleTap}
            style={{ margin: 0, fontSize: 25, cursor: "default", userSelect: "none" }}
          >
            LilyMac Hub
          </h1>
          <p style={{ color: "#64748b", marginBottom: 0 }}>
            {isAdmin ? "Administrator access" : "VIP member access"}
          </p>
        </div>

        <h2 style={{ fontSize: 19, margin: "24px 0 5px" }}>
          {isAdmin ? "Administrator sign in" : "VIP member sign in"}
        </h2>
        <p style={{ color: "#64748b", fontSize: 13, marginTop: 0 }}>
          {isAdmin
            ? "Use your administrator username and password."
            : "Use your registered phone number and password."}
        </p>

        <form onSubmit={submit}>
          <label style={styles.label}>
            {isAdmin ? "Username" : "Phone number"}
            <input
              style={styles.input}
              type={isAdmin ? "text" : "tel"}
              value={identifier}
              onChange={(e) => setIdentifier(e.target.value)}
              placeholder={isAdmin ? "Admin username" : "07XXXXXXXX"}
              autoComplete={isAdmin ? "username" : "tel"}
              required
            />
          </label>

          <label style={styles.label}>
            Password
            <input
              style={styles.input}
              type="password"
              value={password}
              onChange={(e) => setPassword(e.target.value)}
              placeholder="Enter your password"
              autoComplete="current-password"
              required
            />
          </label>

          {error && (
            <p role="alert" style={{
              color: "#b91c1c",
              background: "#fef2f2",
              border: "1px solid #fecaca",
              borderRadius: 8,
              padding: 10,
              fontSize: 13,
              lineHeight: 1.5,
            }}>
              {error}
            </p>
          )}

          <button
            type="submit"
            disabled={loading}
            style={{
              ...styles.button,
              marginTop: 24,
              opacity: loading ? 0.65 : 1,
            }}
          >
            {loading ? "Signing in..." : "Sign in"}
          </button>
        </form>

        {!isAdmin && (
          <p style={{
            color: "#64748b",
            textAlign: "center",
            fontSize: 13,
            marginTop: 22,
          }}>
            New to VIP?{" "}
            <button
              type="button"
              onClick={() => navigate("/vip")}
              style={{
                border: 0,
                padding: 0,
                background: "none",
                color: "#2563eb",
                fontWeight: 700,
                cursor: "pointer",
              }}
            >
              Register here
            </button>
          </p>
        )}

        <button
          type="button"
          onClick={() => navigate("/auth")}
          style={{
            display: "block",
            margin: "18px auto 0",
            border: 0,
            background: "none",
            color: "#64748b",
            cursor: "pointer",
            fontSize: 12,
          }}
        >
          Back to Betting Account
        </button>
      </section>
    </main>
  );
}
